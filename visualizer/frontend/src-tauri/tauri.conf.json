{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataCleaner",
  "mainBinaryName": "DataCleaner",
  "version": "0.1.0",
  "identifier": "com.uetxeberria.frontend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Data Cleaner",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/visualizer-backend": "backend"
    },
    "icon": [
      "icons/B-bg.png",
      "icons/B-bg.ico"
    ]
  }
}
